rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Safety Net
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicit matches for documenting schema permissions
    match /app_data/{docId} {
      allow read, write: if true;

      match /dictionary_words/{wordId} {
        allow read, write: if true;
      }

      match /courses/{courseId} {
        allow read, write: if true;
      }

      match /students/{studentId} {
        allow read, write: if true;
      }

      match /student_cursuses/{studentId} {
        allow read, write: if true;
      }

      match /student_stats/{studentId} {
        allow read, write: if true;
      }

      match /students_history/{historyId} {
        allow read, write: if true;
      }

      match /srs_decks/{studentId} {
        allow read, write: if true;
      }
    }
  }
}
